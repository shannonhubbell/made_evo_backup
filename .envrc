# direnv config for MADE Evo local development.
#
# Secrets (.env, .dev.vars, .keys/) are intentionally gitignored, which means
# `git worktree add` never brings them into a new worktree. This file has no
# secrets in it — it just wires up whichever worktree you're in to a single
# canonical secrets directory on your machine, so you never copy secrets
# between worktrees by hand again.
#
# One-time setup per machine (see docs/LOCAL_SECRETS_SETUP.md):
#   mkdir -p ~/.config/made_evo
#   cp /path/to/existing/.env       ~/.config/made_evo/env
#   cp /path/to/existing/.dev.vars  ~/.config/made_evo/dev.vars
#   cp -R /path/to/existing/.keys   ~/.config/made_evo/keys
#
# Per-worktree setup: just run `direnv allow` once.

MADE_SECRETS_DIR="$HOME/.config/made_evo"

# Exports every KEY=VALUE pair as a real shell env var (available to `npm run dev`,
# tsx scripts, etc. via process.env) without needing a physical .env file here.
dotenv_if_exists "$MADE_SECRETS_DIR/env"

# Wrangler (`wrangler pages dev`) and some scripts read these as physical files on
# disk rather than from the environment, so symlink them into this worktree.
if [ -e "$MADE_SECRETS_DIR/dev.vars" ] && [ ! -e .dev.vars ]; then
  ln -s "$MADE_SECRETS_DIR/dev.vars" .dev.vars
fi
if [ -e "$MADE_SECRETS_DIR/keys" ] && [ ! -e .keys ]; then
  ln -s "$MADE_SECRETS_DIR/keys" .keys
fi
