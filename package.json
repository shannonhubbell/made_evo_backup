{
  "name": "made-evo",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:preview": "CONTENTFUL_PREVIEW=true astro dev",
    "build": "npm run build:static",
    "build:static": "export STATIC_BUILD=true NODE_OPTIONS='--max-old-space-size=4096' && npm run sync:contentful && npm run validate:schemas && npm run generate:square-catalog-static && astro build",
    "build:server": "unset STATIC_BUILD && export NODE_OPTIONS='--max-old-space-size=4096' && npm run sync:contentful && npm run validate:schemas && npm run generate:square-catalog-static && astro build",
    "preview": "npm run build:server && wrangler pages dev ./dist",
    "preview:local": "wrangler pages dev ./dist",
    "astro": "astro",
    "sync:contentful": "npm run generate:types && npm run populate:adapter-mapping",
    "generate:types": "tsx scripts/generate-contentful-types.ts",
    "populate:adapter-mapping": "tsx scripts/populate-adapter-id-mapping.ts",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "translate:contentful-pages": "tsx scripts/translate-contentful-pages.ts",
    "list:contentful-locales": "tsx scripts/list-contentful-locales.ts",
    "generate:contentful-slugs": "tsx tools/contentful/slug_generator.ts",
    "query:square-catalog": "tsx scripts/query-square-catalog.ts",
    "test:square-connection": "tsx scripts/test-square-connection.ts",
    "generate:square-catalog-static": "tsx scripts/generate-square-catalog-static.ts",
    "test:figma": "tsx scripts/test-figma-connection.ts",
    "test:figma-pages": "tsx scripts/test-figma-page-variants.ts",
    "generate:figma-pages": "tsx scripts/generate-figma-pages.ts",
    "extract:figma-people": "tsx scripts/extract-figma-people-data.ts",
    "push:people-to-contentful": "tsx scripts/push-people-to-contentful.ts",
    "push:eventbrite-to-contentful": "tsx scripts/push-eventbrite-events-to-contentful.ts",
    "github:issues": "tsx scripts/github-issues.ts",
    "map:indie-dev-coworking-events": "tsx scripts/map-indie-dev-coworking-events.ts",
    "migrate:events-to-cta-field": "tsx scripts/migrate-events-to-cta-field.ts",
    "map:events-to-programs": "tsx scripts/map-events-to-programs.ts",
    "delete:all-members": "tsx scripts/delete-all-members.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run src/components/__tests__/Navbar.integration.test.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/node": "^9.2.2",
    "@astrojs/svelte": "^7.0.3",
    "@astrojs/vue": "^5.1.3",
    "@azure/storage-blob": "^12.27.0",
    "@contentful/rich-text-html-renderer": "^17.1.6",
    "@tailwindcss/vite": "^4.1.11",
    "@tailwindplus/elements": "^1.0.19",
    "@types/qrcode": "^1.5.6",
    "apexcharts": "^4.3.0",
    "astro": "^5.1.1",
    "classnames": "^2.5.1",
    "contentful": "^11.9.0",
    "contentful-cli": "^3.8.8",
    "csv-parse": "^5.6.0",
    "flowbite": "^3.1.2",
    "googleapis": "^171.4.0",
    "marked": "^17.0.1",
    "qrcode": "^1.5.4",
    "qrcode-svg": "^1.1.0",
    "svelte": "^5.16.2",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.25",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.2",
    "@types/qrcode-svg": "^1.1.5",
    "@vitest/coverage-v8": "^2.1.9",
    "contentful-management": "^11.66.0",
    "svelte-check": "^4.1.1",
    "svelte-preprocess": "^6.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
