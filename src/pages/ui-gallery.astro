import Layout from "../layouts/Layout.astro";
import Splash from "../components/Splash.astro";
import NavBar from "../components/Navbar.astro";
import { GridItemSchema, validateMenuItems, TimelineItemSchema, validateTimelineItems } from "../schema/ui";

import "../styles/global.css";
import ResponsiveGrid from "../components/ResponsiveGrid.astro";
import VerticalTimeline from "../components/VerticalTimeline.astro";
import Calendar from "../components/Calendar.astro";
import Graph from "../components/Graph.astro";
import StatsBar from "../components/StatsBar.astro";
import GoogleFormLoader from "../components/hydrated/forms/GoogleFormLoader.vue";
import GoogleSheetFormLoader from "../components/hydrated/forms/GoogleSheetFormLoader.vue";
import navigationMenuItemsData from "../testContent/navigationMenuItems.json";

let gridItems = [
  GridItemSchema.parse({
    image: "/item1.png",
    title: "Item 1",
    url: "/item1",
    subtitle: "Info on Item 1"
  }),
  GridItemSchema.parse({
    image: "/item2.png",
    title: "Item 2",
    url: "/item2",
    subtitle: "Info on Item 2"
  }),
  GridItemSchema.parse({
    image: "/item3.png",
    title: "Item 3",
