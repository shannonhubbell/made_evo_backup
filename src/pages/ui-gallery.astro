    image: "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=400&h=400&fit=crop"
  }
]);

// Sample calendar events - converting timeline items to calendar format
const calendarEvents = [
  {
    date: new Date("2024-06-15"),
    title: "Summer Exhibition Opening",
    description: "Grand opening of our summer interactive exhibit featuring modern art installations.",
    url: "/events/summer-exhibition"
  },
  {
    date: new Date("2024-03-20"),
    title: "Spring Workshop Series",
    description: "Educational workshops for children and adults focusing on digital creativity.",
    url: "/events/spring-workshop"
  },
  {
    date: new Date("2024-09-10"),
    title: "Fall Festival Launch",
    description: "Annual fall festival celebrating local artists and community engagement.",
    url: "/events/fall-festival"
  },
  {
    date: new Date("2024-01-05"),
    title: "New Year Program Kickoff",
    description: "Introduction of new year-round programs and membership benefits.",
    url: "/events/new-year-kickoff"
  },
  {
    date: new Date("2024-12-01"),
    title: "Holiday Special Events",
    description: "Seasonal programming including special holiday-themed exhibits and activities.",
    url: "/events/holiday-special"
  },
];

// Sample graph data for bar chart
const graphData = {
  categories: ['January', 'February', 'March', 'April', 'May', 'June'],
  series: [
    {
      name: 'Visitors',
      data: [40, 300, 1800, 2100, 1900, 2400]
    },
    {
      name: 'Events',
      data: [4343, 3, 15238, 18238, 14238, 20238]
    },
    {
      name: 'Programs',
      data: [3434, 7343, 9343, 11343, 10343, 12343]
    }
  ]
};

// Sample stats data for StatsBar
const statsData = [
  {
    label: 'Total Visitors',
    value: 12543,
    trend: {
      direction: 'up' as const,
      percentage: 12.5
    },
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z'
  },
  {
    label: 'Active Programs',
    value: 24,
    trend: {
      direction: 'up' as const,
      percentage: 8.3
    },
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01'
  },
  {
    label: 'Community Engagement',
    value: 89,
    trend: {
      direction: 'up' as const,
