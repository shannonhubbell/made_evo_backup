// Navigation menu data
const navigationMenuItems = validateMenuItems(navigationMenuItemsData);

// Google Sheets demo – spreadsheet ID from env or default
const googleSheetId = import.meta.env.GOOGLE_SHEET_ID || '1voWkOwdw79okFLqtPNeWyvjbd15Oks0t0-sJKotXUiM';
// Sample timeline data - demonstrating unsorted chronological data
const timelineItems = validateTimelineItems([
