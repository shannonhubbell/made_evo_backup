---
<Layout>

   <Splash
     padding="lg"
     overlay={true}
     overlayOpacity="medium"
     isFirstInContainer={true}
     contents={[{
       videoPoster: "https://images.steelcase.com/image/upload/c_fill,q_auto,f_auto,h_900,w_1600/v1567243086/6130_1000.jpg",
       subtitle: "Wed - Sun | All-Playable Exhibit Floor",
       title: "Playable Video Game Exhibits from Pong to the Xbox 360"
     }]}
   />

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Programs</h2>
    <ResponsiveGrid
      items={ gridItems.map((gridItem) => {
        return {
          image: `${gridItem.image}`,
          title: `${gridItem.title}`,
          url: `${gridItem.url}`,
          subtitle: `${gridItem.subtitle}`
        }
      }) }
      maxGridItems="4"
    />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Event Timeline</h2>
    <VerticalTimeline items={timelineItems} />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Calendar</h2>
    <Calendar events={calendarEvents} showNavigation={true} />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Organization Health Overview</h2>
    <StatsBar stats={statsData} />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Statistics Chart (Bar)</h2>
    <Graph
      data={graphData}
      title="Monthly Museum Statistics"
      height="400px"
      type="bar"
    />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Trend Analysis Chart (Line)</h2>
    <Graph
      data={graphData}
      title="Monthly Museum Trends"
      height="400px"
      type="trend"
    />
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Google Form (native embed)</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-2xl">
      Native Google Form embed for slug &quot;google-form-proposal-form&quot;.
    </p>
    <div
      class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
    >
      <GoogleFormLoader slug="google-form-proposal-form" client:load />
    </div>
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Google Sheet Form (spreadsheet-form-community-proposal)</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-2xl">
      Form with labels from the first row of the Google Sheet.
    </p>
    <div
      class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 max-w-xl"
    >
      <GoogleSheetFormLoader slug="spreadsheet-form-community-proposal" client:load />
    </div>
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">SpreadsheetForm (Contentful)</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-2xl">
      All SpreadsheetForm entries from Contentful.
    </p>
    <div
      id="spreadsheet-form-demo"
      class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
    >
      <div class="text-gray-500 dark:text-gray-400 text-sm" data-form-status>Loading…</div>
      <pre class="mt-4 text-sm overflow-x-auto hidden" data-form-output></pre>
    </div>
  </div>

  <div class="lg:container mx-auto px-4 py-8">
    <h2 class="ui-h3 mb-4">Google Sheets API Demo</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-2xl">
      First 10 cells of row 1 from the configured spreadsheet (service account).
    </p>
    <div
      id="sheets-demo"
      class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
    >
      <div class="text-gray-500 dark:text-gray-400 text-sm" data-sheets-status>Loading…</div>
      <pre class="mt-4 text-sm overflow-x-auto hidden" data-sheets-output></pre>
    </div>
  </div>

</Layout>

<script define:vars={{ googleSheetId }}>
  // All SpreadsheetForms from Contentful
  const formDemo = document.getElementById('spreadsheet-form-demo');
  if (formDemo) {
    const formStatus = formDemo.querySelector('[data-form-status]');
    const formOutput = formDemo.querySelector('[data-form-output]');
    fetch('/api/google/sheets/index.json')
      .then((r) => r.json())
      .then((data) => {
        if (data.error) {
          formStatus.textContent = `Error: ${data.error}`;
          formStatus.classList.add('text-red-600', 'dark:text-red-400');
        } else {
          const items = data.items ?? [];
          formStatus.textContent = `Loaded ${items.length} SpreadsheetForm(s)`;
          if (formOutput) {
            formOutput.textContent = JSON.stringify(data, null, 2);
            formOutput.classList.remove('hidden');
          }
        }
      })
      .catch((e) => {
        formStatus.textContent = `Error: ${e.message}`;
        formStatus.classList.add('text-red-600', 'dark:text-red-400');
      });
  }

  // Google Sheets row data
  const demo = document.getElementById('sheets-demo');
  if (demo && googleSheetId) {
    const status = demo.querySelector('[data-sheets-status]');
    const output = demo.querySelector('[data-sheets-output]');
    const url = `/api/google/form.json?spreadsheetId=${encodeURIComponent(googleSheetId)}`;

    fetch(url)
      .then((r) => r.json())
      .then((data) => {
        if (data.error) {
          status.textContent = `Error: ${data.error}`;
          status.classList.add('text-red-600', 'dark:text-red-400');
        } else {
          status.textContent = `Range: ${data.range}`;
          if (output) {
            output.textContent = JSON.stringify(data.values, null, 2);
            output.classList.remove('hidden');
          }
        }
      })
      .catch((e) => {
        status.textContent = `Error: ${e.message}`;
        status.classList.add('text-red-600', 'dark:text-red-400');
      });
  }
</script>
