---
// Checkout page with embedded Square card form (no redirect to Square)
// Route: /en/store/checkout, /es/store/checkout, etc.
import StoreCheckout from '../../../components/hydrated/StoreCheckout.vue';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';
import { isValidLocale, getDefaultLocale, normalizeLocaleCode } from '../../../lib/contentful/locales';
import { getSquareEnv } from '../../../lib/square-env';

export const prerender = false;

const { locale: localeParam } = Astro.params;

let locale = localeParam || 'en-US';
if (!locale.includes('-')) {
  locale = await normalizeLocaleCode(locale);
}

const isValid = await isValidLocale(locale);
if (!isValid) {
  const defaultLocale = await getDefaultLocale();
  const defaultLocaleShort = defaultLocale.split('-')[0];
  return Astro.redirect(`/${defaultLocaleShort}/store/checkout`, 302);
}

Astro.locals.locale = locale;

// Use runtime env (Cloudflare) or import.meta.env (local)
const { squareApplicationId, squareLocationId, squareEnvironment } = getSquareEnv({ locals: Astro.locals });
---
<Layout>
  <div class="py-12 max-w-2xl mx-auto px-4">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Checkout</h1>
    <StoreCheckout
      client:load
      squareApplicationId={squareApplicationId}
      squareLocationId={squareLocationId}
      squareEnvironment={squareEnvironment}
      locale={locale}
    />
  </div>
</Layout>
