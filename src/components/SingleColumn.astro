---
import { DoubleColumnPropsSchema, type DoubleColumnItem } from "../schema/ui";
import type z from "zod";
import ImageResponsive from "./ImageResponsive.astro";

type BaseProps = z.infer<typeof DoubleColumnPropsSchema>;

export interface SingleColumnProps extends BaseProps {
    truncateLength?: number;
    /** When true, add top margin equal to navbar height (use when this block is the first in the main container) */
    isFirstInContainer?: boolean;
}

const { isTitleVisible, items, title, truncateLength, isFirstInContainer } = Astro.props as SingleColumnProps;

// Function to truncate HTML content to a maximum character count (text only, not HTML tags)
function truncateHtml(html: string, maxLength: number): string {
    if (!maxLength) {
        return html;
    }

    // Strip HTML tags to get plain text for length calculation
    const textContent = html.replace(/<[^>]*>/g, '');

    // If text content is already shorter than maxLength, return as-is
    if (textContent.length <= maxLength) {
        return html;
    }

    // Truncate by counting text characters (not HTML tags)
    let textCount = 0;
    let result = '';
    let inTag = false;
    let tagBuffer = '';
    let lastSpacePos = -1;
    let lastSpaceTextCount = 0;

    for (let i = 0; i < html.length; i++) {
        const char = html[i];

        if (char === '<') {
            inTag = true;
            tagBuffer = char;
        } else if (char === '>') {
            inTag = false;
            tagBuffer += char;
            result += tagBuffer;
            tagBuffer = '';
        } else if (inTag) {
            tagBuffer += char;
        } else {
            if (textCount >= maxLength) {
                // Find the last space to avoid cutting words
                if (lastSpacePos > 0 && lastSpaceTextCount > maxLength * 0.7) {
                    result = result.substring(0, lastSpacePos);
                }
                result += '...';
                break;
            }
            result += char;
            textCount++;

            // Track the last space position
            if (char === ' ') {
                lastSpacePos = result.length;
                lastSpaceTextCount = textCount;
            }
        }
    }

    return result;
}

---
<!-- <div class:list={["lg:container mx-auto px-4 py-8", isFirstInContainer && "mt-20"]}> -->
 <div class:list={[isFirstInContainer && "mt-[calc(5rem+var(--alert-height))] transition-[margin-top] duration-[350ms] ease-in-out"]}>
    <div class="flex flex-row flex-wrap">
        <div class="sm:basis-1/3 basis-full p-4 pb-0 mb-0">
        </div>
        <div class:list={["sm:basis-2/3 lg:basis-5/12 basis-full relative", title && isTitleVisible && "p-4"]}>
            { title && isTitleVisible ? (<h1 class="text-[18pt]">{title}</h1>) : "" }
        </div>
        { items?.map((item: DoubleColumnItem) => (
            <div class="sm:basis-1/3 basis-full p-4 pb-0 mb-0">
                {item.image ? (
                    <ImageResponsive
                        src={item.image}
                        alt={item.title || "Content image"}
                        class="w-full aspect-[16/9] sm:aspect-square md:aspect-[4/3] lg:aspect-[16/9] lg:w-3/4 max-w-full h-auto object-cover rounded-lg block ml-auto"
                    />
                ) : null}
            </div>
            <div class="sm:basis-2/3 lg:basis-5/12 basis-full p-4 relative">
                { isTitleVisible ? (<h2 class="ui-h4 weight-black mb-4 text-left">{item.title}</h2>) : "" }
                <div class="content-wrapper" set:html={ truncateLength ? truncateHtml(item.content, truncateLength) : item.content } />
                {
                    item.callToAction ? (
                        <a
                            href={item.callToAction.url}
                            target={item.callToAction.url?.startsWith('http') ? '_blank' : undefined}
                            rel={item.callToAction.url?.startsWith('http') ? 'noopener noreferrer' : undefined}
                            class="bg-blue-500 text-white px-6 py-3 rounded-full mt-4 uppercase font-bold inline-flex items-center gap-2 w-fit shadow-md hover:bg-blue-600 hover:shadow-lg transition-all"
                        >
                            {item.callToAction.title}
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    ) : <></>
                }
            </div>
        )) || []}
    </div>
</div>
