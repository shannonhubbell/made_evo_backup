---

---
<div id="mc_embed_shell">
    <h2 class="uppercase text-sm col-span-full font-bold mb-3">Subscribe to Newsletter</h2>
    <div id="mc_embed_signup">
        <form
            action="https://themade.us12.list-manage.com/subscribe/post?u=efa463dd16aa902cf54a317bb&amp;id=3fcce32be7&amp;f_id=00ebb6e0f0"
            method="post"
            id="mc-embedded-subscribe-form"
            name="mc-embedded-subscribe-form"
            class="validate"
            target="_self"
            novalidate
        >
            <div id="mc_embed_signup_scroll" class="flex flex-col gap-2">
                <div class="mc-field-group">
                    <label for="mce-EMAIL" class="sr-only">Email Address <span class="asterisk">*</span></label>
                    <input
                        type="email"
                        name="EMAIL"
                        class="required email w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-blue-500 dark:focus:border-blue-400 transition-colors"
                        id="mce-EMAIL"
                        placeholder="Email address"
                        autocomplete="email"
                        required
                        value=""
                    />
                </div>
                <div id="mce-responses" class="clear foot">
                    <div class="response text-sm text-red-600 dark:text-red-400" id="mce-error-response" style="display: none;"></div>
                    <div class="response text-sm text-green-600 dark:text-green-400" id="mce-success-response" style="display: none;"></div>
                </div>
                <div aria-hidden="true" style="position: absolute; left: -5000px;">
                    <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups -->
                    <input type="text" name="b_efa463dd16aa902cf54a317bb_3fcce32be7" tabindex="-1" value="" />
                </div>
                <div class="indicates-required text-xs text-gray-500 dark:text-gray-400">
                    <span class="asterisk">*</span> indicates required
                </div>
                <div class="optionalParent">
                    <div class="clear foot">
                        <input
                            type="submit"
                            name="subscribe"
                            id="mc-embedded-subscribe"
                            class="button w-full bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-700 text-white font-semibold px-4 py-2 text-sm rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                            value="Subscribe"
                        />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
  // Mailchimp signup form - client-side email validation.
  // The form's `novalidate` attribute (Mailchimp's own embed convention) disables
  // the browser's built-in constraint validation, so we enforce a "looks like an
  // email" check ourselves before allowing the (cross-origin) submit to Mailchimp.
  function initMailchimpForm() {
    const form = document.getElementById('mc-embedded-subscribe-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('mce-EMAIL') as HTMLInputElement | null;
    const errorResponse = document.getElementById('mce-error-response');

    if (!form || !emailInput || !errorResponse) return;

    const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function looksLikeEmail(value: string): boolean {
      return EMAIL_PATTERN.test(value.trim());
    }

    function showError(message: string) {
      errorResponse.textContent = message;
      (errorResponse as HTMLElement).style.display = 'block';
      emailInput.classList.add('border-red-500', 'dark:border-red-500');
      emailInput.setAttribute('aria-invalid', 'true');
    }

    function clearError() {
      (errorResponse as HTMLElement).style.display = 'none';
      errorResponse.textContent = '';
      emailInput.classList.remove('border-red-500', 'dark:border-red-500');
      emailInput.removeAttribute('aria-invalid');
    }

    emailInput.addEventListener('input', () => {
      if (errorResponse.textContent) clearError();
    });

    form.addEventListener('submit', (event) => {
      const value = emailInput.value;

      if (!value || !looksLikeEmail(value)) {
        event.preventDefault();
        showError('Please enter a valid email address.');
        emailInput.focus();
        return;
      }

      clearError();
    });
  }

  document.addEventListener('DOMContentLoaded', initMailchimpForm);
</script>
